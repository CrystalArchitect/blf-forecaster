# Copy to .env and fill in. `blf` loads .env automatically.
# (If these are already exported in your shell, you can skip the .env entirely.)

# ---- LLM (OpenAI-compatible) ----
# Provider preset: openrouter | gateway | groq | openai
BLF_LLM_PROVIDER=openrouter
# Key for the chosen provider (openrouter -> OPENROUTER_API_KEY, etc.)
OPENROUTER_API_KEY=
# Optional per-role model overrides:
# BLF_MAIN_MODEL=openai/gpt-4o-mini
# BLF_SUMMARIZER_MODEL=openai/gpt-4o-mini
# Force single tool call each turn ("required"); falls back to "auto" if rejected.
# BLF_TOOL_CHOICE=required

# For the gitlawb gateway instead, use:
# BLF_LLM_PROVIDER=gateway
# OPENAI_BASE_URL=https://opengateway.gitlawb.com/v1
# OPENAI_API_KEY=...
# OPENAI_MODEL=mimo-v2.5-pro

# ---- Search ----
# Provider: perplexity | brave
BLF_SEARCH_PROVIDER=perplexity
PERPLEXITY_API_KEY=
# BLF_PERPLEXITY_MODEL=sonar
# For Brave instead: BLF_SEARCH_PROVIDER=brave and BRAVE_API_KEY=...
